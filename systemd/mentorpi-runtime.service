[Unit]
Description=Frussen Robotics MentorPi Runtime

[Service]
Type=simple
WorkingDirectory=/home/pi/frussen-robotics/mentorpi
ExecStart=/home/pi/frussen-robotics/mentorpi/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
