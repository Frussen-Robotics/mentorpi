[Unit]
Description=MentorPi local wake phrase listener
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/mentorpi/wake.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env ${WAKE_PYTHON} ${WAKE_SCRIPT}
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
