# Copy settings to ~/.config/mentorpi/battery-monitor.env
# Use absolute paths for this robot. Keep the real API key outside Git.
MENTORPI_BATTERY_SCRIPT="/absolute/path/to/mentorpi/battery_monitor.py"
MENTORPI_SPEAK_SCRIPT="/absolute/path/to/workspace/skills/speak/scripts/run.py"
OPENAI_API_KEY=""
MENTORPI_STATUS_URL="http://127.0.0.1:8000/status"
MENTORPI_BATTERY_LOW_MV="7200"
MENTORPI_BATTERY_RESET_MV="7400"
MENTORPI_BATTERY_INTERVAL_SECONDS="10"
SPEAK_ALSA_DEVICE="default"
SPEAK_LIVE_VOICE="cedar"
SPEAK_BUFFER_MS="200"
